# .env.example — Copia como .env y completa los valores
# NUNCA subas el .env real al repositorio

# URL base del frontend (en producción: IP pública de la EC2 Frontend)
# En desarrollo local no se usa — el proxy de vite.config.js maneja el reenvío
VITE_API_URL=http://localhost

# Usuario de Docker Hub — necesario en la EC2 para que docker compose pull
# sepa qué imagen descargar (en local no se necesita)
DOCKER_USERNAME=matichavezg